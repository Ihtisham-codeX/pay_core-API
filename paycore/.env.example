# ─── PayCore Frontend configuration ──────────────────────────────────────────
# Copy this file to ".env" and adjust if needed.
#
# In Vite, only variables that start with VITE_ are exposed to the browser.
# Never put backend secrets (DB passwords, JWT secrets, Redis passwords) in
# this file — anything here is visible to anyone who opens your website.
#
# VITE_API_BASE_URL = base URL of the FastAPI backend.
#   - Leave EMPTY (default) in development: the app calls "/api/..." and the
#     Vite dev server forwards it to FastAPI (see proxy in vite.config.js).
#   - In production, set the full base INCLUDING the /api prefix, e.g.
#     VITE_API_BASE_URL=https://api.paycore.example.com/api
VITE_API_BASE_URL=
