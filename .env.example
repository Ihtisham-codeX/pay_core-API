# PostgreSQL 
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=pay_core
PG_USER=postgres
PG_PASSWORD=your_password
PG_SSLMODE=disable

# JWT 
# Generate strong secrets: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_access_token_secret_key
JWT_REFRESH_SECRET_KEY=your_refresh_token_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# ─── App ─────────────────────────────────────────────────────────────────────
# COOKIE_DOMAIN=localhost

# ─── Currency ─────────────────────────────────────────────────────────────────
DEFAULT_CURRENCY=PKR

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_IDEMPOTENCY_TTL_SECONDS=86400
REDIS_RATE_LIMIT_MAX_REQUESTS=60
REDIS_RATE_LIMIT_WINDOW_SECONDS=60
REDIS_CACHE_TTL_SECONDS=300
